{
  "name": "wdio-puppeteer-video-service",
  "version": "1.0.0",
  "description": "WebdriverIO v10 service that records Chromium test videos through Puppeteer and CDP",
  "type": "module",
  "sideEffects": false,
  "packageManager": "npm@12.0.1",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "SUPPORT.md",
    "TROUBLESHOOTING.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./manifest": {
      "types": "./build/manifest.d.ts",
      "import": "./build/manifest.js"
    },
    "./reporter": {
      "types": "./build/reporter.d.ts",
      "import": "./build/reporter.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.1",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanLambe/wdio-puppeteer-video-service.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "prepack": "corepack npm run check:release-version && corepack npm run clean && corepack npm run build && corepack npm run test:unit",
    "test": "corepack npm run test:unit && corepack npm run test:e2e:both && corepack npm run test:e2e:frameworks && corepack npm run test:e2e:cucumber:retry && corepack npm run test:e2e:cucumber:duplicate-names && corepack npm run test:e2e:advanced && corepack npm run test:e2e:capture",
    "test:e2e": "tsx tests/scripts/run-e2e-video-modes.ts multipart",
    "test:e2e:merge": "tsx tests/scripts/run-e2e-video-modes.ts merge",
    "test:e2e:merge-kept": "tsx tests/scripts/run-e2e-video-modes.ts merge-kept",
    "test:e2e:parallel": "tsx tests/scripts/run-e2e-parallel-mode.ts both",
    "test:e2e:faults": "tsx tests/scripts/run-e2e-faults.ts",
    "test:e2e:both": "tsx tests/scripts/run-e2e-video-modes.ts both",
    "test:e2e:classic": "tsx tests/scripts/run-e2e-video-modes.ts both classic",
    "test:e2e:edge": "tsx tests/scripts/run-e2e-video-modes.ts multipart bidi edge",
    "test:e2e:jasmine": "tsx tests/scripts/run-e2e-frameworks.ts jasmine",
    "test:e2e:cucumber": "tsx tests/scripts/run-e2e-frameworks.ts cucumber",
    "test:e2e:frameworks": "tsx tests/scripts/run-e2e-frameworks.ts both",
    "test:e2e:cucumber:retry": "tsx tests/scripts/run-e2e-frameworks.ts cucumber-retry",
    "test:e2e:cucumber:duplicate-names": "tsx tests/scripts/run-e2e-frameworks.ts cucumber-duplicate-names",
    "test:e2e:cucumber:scenario-level": "tsx tests/scripts/run-e2e-frameworks.ts cucumber-scenario-level",
    "test:e2e:capture": "tsx tests/scripts/run-e2e-capture-modes.ts all",
    "test:e2e:capture:bidi": "tsx tests/scripts/run-e2e-capture-modes.ts bidi",
    "test:e2e:capture:classic": "tsx tests/scripts/run-e2e-capture-modes.ts classic",
    "test:e2e:capture:controls": "tsx tests/scripts/run-e2e-capture-modes.ts controls",
    "test:e2e:capture:metadata": "tsx tests/scripts/run-e2e-capture-modes.ts metadata",
    "test:e2e:capture:edge": "tsx tests/scripts/run-e2e-capture-modes.ts edge",
    "test:e2e:capture:low-fps": "tsx tests/scripts/run-e2e-capture-modes.ts low-fps",
    "test:e2e:capture:animation": "tsx tests/scripts/run-e2e-capture-modes.ts animation",
    "test:e2e:capture:unprimed": "tsx tests/scripts/run-e2e-capture-modes.ts unprimed",
    "test:e2e:capture:sustained": "tsx tests/scripts/run-e2e-capture-modes.ts sustained",
    "test:e2e:capture:quiet": "tsx tests/scripts/run-e2e-capture-modes.ts quiet",
    "test:e2e:capture:bounded": "tsx tests/scripts/run-e2e-capture-modes.ts bounded",
    "test:e2e:capture:cropped-region": "tsx tests/scripts/run-e2e-capture-modes.ts cropped-region",
    "test:e2e:advanced": "tsx tests/scripts/run-e2e-advanced-options.ts all",
    "test:e2e:advanced:windows": "tsx tests/scripts/run-e2e-advanced-options.ts windows",
    "test:e2e:advanced:retry": "tsx tests/scripts/run-e2e-advanced-options.ts retry",
    "test:e2e:advanced:spec-file-retry": "tsx tests/scripts/run-e2e-advanced-options.ts spec-file-retry",
    "test:e2e:advanced:spec-level": "tsx tests/scripts/run-e2e-advanced-options.ts spec-level",
    "test:e2e:advanced:no-segment": "tsx tests/scripts/run-e2e-advanced-options.ts no-segment",
    "test:e2e:advanced:test-full-style": "tsx tests/scripts/run-e2e-advanced-options.ts test-full-style",
    "test:e2e:advanced:session-style": "tsx tests/scripts/run-e2e-advanced-options.ts session-style",
    "test:e2e:advanced:session-full-style": "tsx tests/scripts/run-e2e-advanced-options.ts session-full-style",
    "test:e2e:advanced:deferred-merge": "tsx tests/scripts/run-e2e-advanced-options.ts deferred-merge",
    "test:e2e:advanced:global-concurrency": "tsx tests/scripts/run-e2e-advanced-options.ts global-concurrency",
    "test:e2e:advanced:ffmpeg-failure": "tsx tests/scripts/run-e2e-advanced-options.ts ffmpeg-failure",
    "test:e2e:advanced:include-spec": "tsx tests/scripts/run-e2e-advanced-options.ts include-spec",
    "test:e2e:advanced:exclude-spec": "tsx tests/scripts/run-e2e-advanced-options.ts exclude-spec",
    "test:unit": "vitest run --exclude \"tests/integration/**\"",
    "test:integration:windows-process": "vitest run tests/integration/windows-process-tree.test.ts",
    "test:integration:screencast": "vitest run tests/integration/screencast-shutdown.test.ts tests/integration/screencast-startup.test.ts",
    "test:integration:report": "vitest run tests/integration/report-generation.test.ts",
    "test:integration:timeline": "vitest run tests/integration/screencast-timeline.test.ts tests/integration/action-markers.test.ts",
    "test:integration:pipeline": "vitest run tests/integration/pipeline-host.test.ts",
    "test:coverage": "vitest run --exclude \"tests/integration/**\" --coverage",
    "test:consumer": "corepack npm run clean && corepack npm run build && tsc -p tests/package-consumer/tsconfig.json && tsx scripts/check-packed-consumer.ts",
    "typecheck": "tsc -p tsconfig.spec.json",
    "package:check": "corepack npm run check:release-version && corepack npm run clean && corepack npm run build && tsc -p tests/package-consumer/tsconfig.json && tsx scripts/check-packed-consumer.ts",
    "pr:check": "corepack npm run lint && corepack npm run typecheck && corepack npm run test && corepack npm run package:check",
    "release:check": "corepack npm run check:release-version && corepack npm run lint && corepack npm run typecheck && corepack npm run test:coverage && corepack npm run test:integration:screencast && corepack npm run test:integration:report && corepack npm run test:integration:pipeline && corepack npm run package:check && corepack npm run sbom",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && node scripts/check-release-version.ts --sync",
    "check:release-version": "node scripts/check-release-version.ts",
    "bench:encoder": "tsx scripts/bench/encoder-throughput.ts",
    "bench:report": "tsx scripts/bench/report-generation.ts",
    "sbom": "tsx scripts/generate-sbom.ts",
    "release:notes": "tsx scripts/preview-release-notes.ts",
    "audit": "corepack npm audit",
    "audit:signatures": "corepack npm audit signatures",
    "audit:fix": "corepack npm audit fix --package-lock-only --ignore-scripts",
    "audit:fix:latest": "corepack npm audit fix --package-lock-only --ignore-scripts --min-release-age=0",
    "check:install-scripts": "tsx scripts/check-install-scripts.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "bench:pipeline": "tsx scripts/bench/pipeline.ts",
    "test:consumer:e2e": "corepack npm run clean && corepack npm run build && tsx tests/scripts/run-packed-consumer.ts"
  },
  "keywords": [
    "webdriverio",
    "wdio",
    "wdio-service",
    "puppeteer",
    "video",
    "record"
  ],
  "author": {
    "name": "Dan Lambe",
    "email": "danjlambe@gmail.com"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@wdio/allure-reporter": ">=10.1.0 <11",
    "@wdio/reporter": ">=10.1.0 <11",
    "@wdio/types": ">=10.1.0 <11",
    "puppeteer-core": ">=25.0.2 <26",
    "webdriverio": ">=10.1.0 <11"
  },
  "peerDependenciesMeta": {
    "@wdio/allure-reporter": {
      "optional": true
    },
    "@wdio/reporter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^2.31.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/cucumber-framework": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/jasmine-framework": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/reporter": "^10.1.0",
    "@wdio/runner": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/types": "^10.1.0",
    "@wdio/utils": "^10.1.0",
    "expect-webdriverio": "^8.0.0",
    "ffmpeg-static": "^5.3.0",
    "fs-extra": "^11.4.1",
    "publint": "^0.3.25",
    "puppeteer-core": "^25.16.0",
    "rimraf": "^6.1.3",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "webdriverio": "^10.1.0"
  },
  "allowScripts": {
    "edgedriver": false,
    "ffmpeg-static@5.3.0": true,
    "geckodriver": false,
    "esbuild@0.28.2": true
  }
}
